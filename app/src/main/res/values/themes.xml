<resources>
    <!--
      Launcher window theme. Two things matter here:
        - windowShowWallpaper: the real system wallpaper is drawn behind our
          window, so live wallpapers and home-screen parallax work for free and
          we never hold a copy of the wallpaper ourselves.
        - a transparent windowBackground, or the opaque default would cover the
          wallpaper we just asked for.
      All colours come from Compose (ui/theme/Theme.kt), which is why this theme
      defines none and needs no values-night variant.
    -->
    <style name="Theme.PortalLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
