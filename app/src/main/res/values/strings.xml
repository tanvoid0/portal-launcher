    <!-- Automations -->
    <string name="greyscale_title">Greyscale</string>
    <string name="greyscale_summary">Removes colour from Portal\'s own screens. For the whole device, Portal can show you where the system setting is.</string>
    <string name="notification_filter_title">Hold back notifications</string>
    <string name="notification_filter_summary">Snoozes notifications the active profile does not want. They come back when the profile changes.</string>
    <string name="notification_filter_needs_access">Portal needs notification access to hold notifications back. It reads which app sent a notification, on the device — notification contents are never stored or sent anywhere.</string>
    <string name="blocker_title">Block distracting apps</string>
    <string name="blocker_summary">Shows a pause screen over apps this profile blocks, with a way through when you mean it.</string>
    <string name="blocker_needs_usage">Portal needs usage access to notice which app comes to the front. It reads app names only, on the device — nothing is stored or sent anywhere.</string>
    <string name="blocker_needs_overlay">Portal needs to display over other apps to put the pause screen on top of a blocked app.</string>
    <string name="display_comfort_title">Display comfort</string>
    <string name="display_comfort_summary">Sets brightness and refresh rate while this profile is active.</string>
    <string name="display_comfort_needs_write_settings">Portal needs permission to modify system settings to change brightness and refresh rate.</string>
    <string name="dnd_title">Do Not Disturb</string>
    <string name="dnd_summary">Turns on the system\'s own Do Not Disturb while this profile is active.</string>
    <string name="dnd_needs_access">Portal needs Do Not Disturb access to turn it on and off with your profile.</string>
    <string name="power_saver_title">Power Saver</string>
    <string name="power_saver_summary">Closes background apps and dims the display. Ultra also blocks everything but a few essentials.</string>

