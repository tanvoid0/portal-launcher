<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility (API 30+). Declaring the launcher intent is enough to
      enumerate launchable apps via LauncherApps / PackageManager, and it needs
      no QUERY_ALL_PACKAGES — which would drag in a Play declaration form and is
      a common review rejection. Only add QUERY_ALL_PACKAGES if we ever need to
      see packages that have no launcher activity.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      RECEIVE_BOOT_COMPLETED: alarms do not survive a reboot, so a scheduled profile
      switch is silently lost without this.
      SCHEDULE_EXACT_ALARM: "Productivity at 09:00" is a promise; inexact alarms in Doze
      can be hours late. ProfileScheduler degrades to an inexact alarm if it is refused.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Still not declared, because nothing implements them yet and a permission with no
      code behind it is review liability:
        SYSTEM_ALERT_WINDOW + FOREGROUND_SERVICE_SPECIAL_USE -> app blocker overlay
      See PRODUCTION_PLAN.md phase 6.
    -->

    <application
        android:name=".PortalLauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PortalLauncher"
        tools:ignore="UnusedAttribute"><!-- enableOnBackInvokedCallback is API 33+; older devices ignore it -->

        <!-- Launcher: MAIN + HOME + DEFAULT so app can be set as default home. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PortalLauncher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Quick Settings tile that cycles profiles. Reachable from inside any app, which
          is where the user is when they notice they are in the wrong mode.
        -->
        <service
            android:name=".automation.ProfileTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Re-arms the profile schedule. Not exported: only the alarm we set and the
          system's own boot/time broadcasts should ever reach it.
        -->
        <receiver
            android:name=".automation.ProfileScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.tanvoid0.portallauncher.action.SCHEDULE_TICK" />
            </intent-filter>
        </receiver>

        <!-- NotificationListenerService for per-profile notification filtering. -->
        <service
            android:name=".automation.PortalNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
